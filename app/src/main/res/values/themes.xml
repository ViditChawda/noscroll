<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NoScroll" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_pink</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#5C1520</item>
        <item name="colorOnPrimaryContainer">#FFD9DC</item>
        <item name="colorSecondary">@color/brand_orange</item>
        <item name="android:colorBackground">@color/ns_bg</item>
        <item name="colorSurface">@color/ns_surface</item>
        <item name="colorOnSurface">@color/ns_text</item>
        <item name="android:windowBackground">@color/ns_bg</item>
        <item name="android:statusBarColor">@color/ns_bg</item>
        <item name="android:navigationBarColor">@color/ns_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="NS.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>
    <style name="NS.Section" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ns_text_2</item>
    </style>
    <style name="NS.RowTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ns_text</item>
    </style>
    <style name="NS.RowSub" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ns_text_2</item>
    </style>
</resources>
